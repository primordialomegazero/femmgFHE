# ═══════════════════════════════════════════════════════════════
# SPIRAL FRACTAL iO — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# Environment (development | test | production)
FEMMG_ENV=production

# Database
FEMMG_DB_PATH=/app/data/spiral_fractal.db
FEMMG_DB_PASSPHRASE=change-me-to-a-strong-passphrase

# FHE
FEMMG_RING_DIM=32768
FEMMG_CKKS_DEPTH=200

# Fractal iO
FEMMG_VARIANTS=12
FEMMG_FRACTAL_LAYERS=23
FEMMG_FRACTAL_DEPTH=7
FEMMG_STATS_SAMPLES=100

# TLS
FEMMG_TLS_ENABLED=true
FEMMG_TLS_CERT=/app/certs/server.crt
FEMMG_TLS_KEY=/app/certs/server.key
FEMMG_TLS_DOMAIN=spiralfractal.io

# Auth (HydraJWT)
FEMMG_AUTH_ENABLED=true
FEMMG_AUTH_CONSENSUS_THRESHOLD=0.618

# Defense
FEMMG_DEFENSE_ENABLED=true
FEMMG_DEFENSE_HONEYPOTS=256

# Secrets (DO NOT COMMIT REAL VALUES)
FEMMG_MASTER_SEED=0.123456789
FEMMG_API_KEY=sk-change-me
